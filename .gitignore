# pyenv
#   For a library or package, you might want to ignore these files since they are
#   intended to be used within projects rather than shared by users.
#   - for .python-version, see https://github.com/trehn/python-version-file#why
.python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in some cases developers wish to ignore locks.
#   pipfile.lock

# poetry
#   Similar to Pipfile.lock, it is generally recommended to include poetry.lock in version control.
#   This is a general rule of thumb.

# sweetviz target
#   You might want to exclude html reports generated by sweetviz
#   sweetviz_report.html

